{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nijaru/polish/training-record.schema.json",
  "title": "Polish training record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "split",
    "source",
    "task",
    "input",
    "target"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "holdout"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "license",
        "rights_note",
        "acquired_at"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "public-domain",
            "permissive-license",
            "user-provided",
            "authored"
          ]
        },
        "origin": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "rights_note": {"type": "string", "minLength": 1},
        "acquired_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "task": {"enum": ["generation", "revision", "critique", "outline"]},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief"],
      "properties": {
        "brief": {"type": "string", "minLength": 1},
        "draft": {"type": "string"},
        "constraints": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "target": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
